static func get_text(lang: String, key: String) -> String:
	if STRINGS.has(lang) and STRINGS[lang].has(key):
		return STRINGS[lang][key]
	if STRINGS.has("en") and STRINGS["en"].has(key):
		return STRINGS["en"][key]
	return key
